+def is_laptop() -> bool:
+    """Use chassis type or a system battery; never infer the user's GPU profile."""
+    chassis = read("/sys/class/dmi/id/chassis_type").strip()
+    if chassis in {"8", "9", "10", "14", "30", "31", "32"}:
+        return True
+    return any(read(p / "type").strip() == "Battery" for p in Path("/sys/class/power_supply").glob("*"))
